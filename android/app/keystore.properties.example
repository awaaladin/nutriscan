# Copy to keystore.properties (gitignored) and fill in with your real release
# keystore. Generate one with:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias nutriscan
#
# Keep this keystore and these passwords safe -- losing them means you can
# never again publish an update to an app already live on the Play Store.
storeFile=/absolute/path/to/release.jks
storePassword=
keyAlias=nutriscan
keyPassword=
